# Disposable SSH server for integration tests. Never use outside tests.
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache openssh-server openssh-sftp-server coreutils bash sudo \
 && adduser -D -s /bin/bash pw && echo 'pw:correct horse' | chpasswd \
 && adduser -D -s /bin/bash key && passwd -u key \
 && adduser -D -s /bin/bash kbd && echo 'kbd:kbd-secret' | chpasswd \
 && mkdir -p /home/key/.ssh && chmod 700 /home/key/.ssh \
 && echo 'pw ALL=(ALL) ALL' > /etc/sudoers.d/pw && chmod 440 /etc/sudoers.d/pw
COPY sshd_config /etc/ssh/sshd_config
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 22
ENTRYPOINT ["/entrypoint.sh"]
